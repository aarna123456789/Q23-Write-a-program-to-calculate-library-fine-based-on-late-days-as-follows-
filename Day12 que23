first 5 days:2rupees/day
next 5 days:4rupees/day
next 20 days days later:6rupees/day
more than 30 days:membership canceled

#include<stdio.h>
int main()
{
int days,fine;
printf("enter number of late days");
scanf("%d"&days);
if(days<=5)
{
fine=days*2;
printf("library fine is %d",fine);
}
else if(days<=10)
{
fine=(5*2)+((days-5)*4);
printf("library fine %d",fine);
}
else if(days<=30)
{
fine=(5*2)+(5*4)+((days-10)*6);
printf("library fine is %d",fine);
}
else
{
printf("membership cancelled");
}
return 0;
}
